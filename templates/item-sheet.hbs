<div class="mh2-sheet mh2-item-sheet">

  <header class="mh2-header">
    <img class="mh2-portrait mh2-portrait-sm" data-action="editImage" src="{{item.img}}" alt="{{item.name}}" title="Change icon">
    <div class="mh2-identity">
      <input class="mh2-name" type="text" name="name" value="{{item.name}}" placeholder="Move name">
      <div class="mh2-item-selects">
        <label class="mh2-stat-select">
          <span>Rolls with</span>
          <select name="system.stat">
            {{#each statOptions}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        <label class="mh2-stat-select">
          <span>Bonus</span>
          <input class="mh2-bonus-input" type="number" name="system.bonus" value="{{system.bonus}}" step="1" title="Flat bonus added to this move's roll">
        </label>
        <label class="mh2-stat-select">
          <span>Group</span>
          <input class="mh2-group-input" type="text" name="system.group" value="{{system.group}}" placeholder="Hexes, Bargains…" title="Optional grouping label shown as a sub-header">
        </label>
        <label class="mh2-stat-select">
          <span>Category</span>
          <select name="system.category">
            {{#each categoryOptions}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        {{#if isSkinMove}}
        <label class="mh2-stat-select">
          <span>Counts as</span>
          <select name="system.basedOn" title="The basic move this move counts as — its text is shown, smaller, on the roll card">
            {{#each basedOnOptions}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        {{/if}}
        <label class="mh2-stat-select">
          <span>Chat buttons</span>
          <select name="system.actionsMode" title="Which follow-up buttons this move puts on its chat card">
            {{#each actionsModeOptions}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
        </label>
      </div>
      {{#if customActions}}
      <div class="mh2-action-picks">
        {{#each actionOptions}}
        <label><input type="checkbox" name="system.actions.{{this.key}}"{{#if this.checked}} checked{{/if}}> {{this.label}}</label>
        {{/each}}
      </div>
      {{else}}
      <p class="mh2-action-hint">{{#if autoActions}}This text offers: {{autoActions}}.{{else}}Nothing in this text asks for a button.{{/if}}{{#if isSkinMove}} The move it counts as adds its own.{{/if}}</p>
      {{/if}}
    </div>
  </header>

  <div class="mh2-item-body">
    <prose-mirror name="system.description" value="{{system.description}}" toggled>{{{enrichedDescription}}}</prose-mirror>
  </div>

</div>
