<div class="mh2-sheet mh2-board-window">

  <div class="mh2-board-head">
    <select class="mh2-board-select" title="Switch board">
      {{#each boards}}
      <option value="{{this.id}}"{{#if this.selected}} selected{{/if}}>{{this.name}}</option>
      {{/each}}
    </select>
    <a class="mh2-btn" data-action="addBoard" title="New board">＋</a>
    {{#if isGM}}<a class="mh2-btn mh2-del" data-action="deleteBoard" title="Delete this board"><i class="fa-solid fa-trash"></i></a>{{/if}}
    {{#if hasBoard}}
    <a class="mh2-btn mh2-btn-text" data-action="toggleBg" title="Cycle background">bg</a>
    <a class="mh2-btn mh2-btn-text" data-action="addCard" title="Add a card">＋ card</a>
    {{/if}}
    <span class="mh2-hint-inline">drag cards · double-click a card to edit · double-click empty space to pin a new one</span>
  </div>

  {{#if hasBoard}}
  <div class="mh2-board-canvas">
    <div class="mh2-board-surface bg-{{board.bg}}">
      {{#each board.cards}}
      <div class="mh2-card card-{{this.color}}" data-card-id="{{this.id}}" style="left: {{this.x}}px; top: {{this.y}}px;">
        <span class="mh2-card-pin"></span>
        <span class="mh2-card-label">{{this.label}}</span>
        {{#if this.note}}<span class="mh2-card-note">{{this.note}}</span>{{/if}}
      </div>
      {{/each}}
    </div>
  </div>
  {{else}}
  <p class="mh2-empty">No boards yet — hit ＋ and found your town.</p>
  {{/if}}

</div>
