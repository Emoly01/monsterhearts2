<div class="mh2-sheet mh2-board-window">

  <div class="mh2-board-head">
    <select class="mh2-board-select" title="Switch board">
      {{#each boards}}
      <option value="{{this.id}}"{{#if this.selected}} selected{{/if}}>{{this.name}}</option>
      {{/each}}
    </select>
    <a class="mh2-btn" data-action="addBoard" title="New board">＋</a>
    {{#if isGM}}<a class="mh2-btn mh2-del" data-action="deleteBoard" title="Delete this board"><i class="fa-solid fa-trash"></i></a>{{/if}}
    {{#if hasBoard}}
    <span class="mh2-board-tools">
      <a class="mh2-btn mh2-btn-text" data-action="addBox" title="Add a box">＋ box</a>
      <a class="mh2-btn mh2-btn-text" data-action="addText" title="Add a text label">＋ text</a>
      <a class="mh2-btn mh2-btn-text" data-action="addLine" title="Add a connector line">＋ line</a>
      <a class="mh2-btn mh2-btn-text" data-action="toggleBg" title="Cycle background">bg</a>
    </span>
    <span class="mh2-hint-inline">drag to move · corner handle resizes · double-click to edit</span>
    {{/if}}
  </div>

  {{#if hasBoard}}
  <div class="mh2-board-canvas">
    <div class="mh2-board-surface bg-{{board.bg}}">

      {{! connector lines sit beneath boxes }}
      {{#each lines}}
      <div class="mh2-el mh2-line-el" data-el-id="{{this.id}}">
        <svg class="mh2-line-svg" width="100%" height="100%">
          <line x1="{{this.x}}" y1="{{this.y}}" x2="{{this.x2}}" y2="{{this.y2}}" class="line-{{this.color}}"/>
          <circle class="mh2-lineend" data-end="a" cx="{{this.x}}" cy="{{this.y}}" r="7"/>
          <circle class="mh2-lineend" data-end="b" cx="{{this.x2}}" cy="{{this.y2}}" r="7"/>
        </svg>
      </div>
      {{/each}}

      {{#each boxes}}
      <div class="mh2-el mh2-box box-{{this.color}}" data-el-id="{{this.id}}"
           style="left: {{this.x}}px; top: {{this.y}}px; width: {{this.w}}px; height: {{this.h}}px;">
        <span class="mh2-box-label">{{this.label}}</span>
        <span class="mh2-resize" title="Resize"></span>
      </div>
      {{/each}}

      {{#each texts}}
      <div class="mh2-el mh2-text text-{{this.color}} size-{{this.size}}" data-el-id="{{this.id}}"
           style="left: {{this.x}}px; top: {{this.y}}px;">{{this.label}}</div>
      {{/each}}

    </div>
  </div>
  {{else}}
  <p class="mh2-empty">No boards yet — hit ＋ and build your world.</p>
  {{/if}}

</div>
