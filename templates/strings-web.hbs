<div class="mh2-sheet mh2-web-window">

  {{#if hasNodes}}
  <div class="mh2-web-canvas">
    <svg viewBox="0 0 {{size}} {{size}}" xmlns="http://www.w3.org/2000/svg" class="mh2-web-svg">
      <defs>
        <marker id="mh2arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto">
          <path class="mh2-web-arrow" d="M 0 0 L 10 5 L 0 10 z"/>
        </marker>
        <marker id="mh2arrow-in" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto">
          <path class="mh2-web-arrow in" d="M 0 0 L 10 5 L 0 10 z"/>
        </marker>
      </defs>

      {{#each edges}}
      <g class="mh2-web-edge" data-from="{{this.from}}" data-to="{{this.to}}">
        <path d="{{this.path}}" stroke-width="{{this.width}}">
          <title>{{this.fromLabel}} holds {{this.count}} on {{this.toLabel}}</title>
        </path>
        <circle cx="{{this.bx}}" cy="{{this.by}}" r="9"/>
        <text x="{{this.bx}}" y="{{this.by}}" text-anchor="middle" dominant-baseline="central">{{this.count}}</text>
      </g>
      {{/each}}

      {{#each nodes}}
      <g class="mh2-web-node{{#if this.isActor}} pc{{else}} npc{{/if}}{{#if this.darkest}} darkest{{/if}}{{#if this.pinned}} pinned{{/if}}" data-node="{{this.id}}">
        <circle class="mh2-web-disc" cx="{{this.x}}" cy="{{this.y}}" r="{{this.r}}"/>
        {{#if this.isActor}}
        <clipPath id="clip-{{this.id}}"><circle cx="{{this.x}}" cy="{{this.y}}" r="{{this.r}}"/></clipPath>
        <image href="{{this.img}}" x="{{this.x}}" y="{{this.y}}" width="{{this.imgSize}}" height="{{this.imgSize}}" transform="translate(-{{this.r}},-{{this.r}}) translate(2,2)" clip-path="url(#clip-{{this.id}})" preserveAspectRatio="xMidYMid slice"/>
        <circle class="mh2-web-ring" cx="{{this.x}}" cy="{{this.y}}" r="{{this.r}}"/>
        {{/if}}
        <text class="mh2-web-label" x="{{this.x}}" y="{{this.y}}" dy="{{this.labelDy}}" text-anchor="middle">{{this.label}}</text>
        {{#if this.conditions}}
        <text class="mh2-web-conditions" x="{{this.x}}" y="{{this.y}}" dy="{{this.condDy}}" text-anchor="middle">{{this.conditions}}</text>
        {{/if}}
      </g>
      {{/each}}
    </svg>
  </div>

  <aside class="mh2-web-side">

    {{! Everyone, most tangled first. Always visible so rows never jump. }}
    <h3>Everyone</h3>
    {{#if hasEdges}}
    <ul class="mh2-web-roster">
      {{#each roster}}
      <li data-node="{{this.id}}" class="{{#if this.isActor}}pc{{else}}npc{{/if}}{{#if this.pinned}} pinned{{/if}}">
        <span class="mh2-web-who">{{this.label}}</span>
        <span class="mh2-web-tally" title="Strings they hold"><i class="fa-solid fa-arrow-up-right-from-square"></i> {{this.holdsTotal}}</span>
        <span class="mh2-web-tally in" title="Strings held on them"><i class="fa-solid fa-arrow-right-to-bracket"></i> {{this.heldTotal}}</span>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="mh2-empty">No Strings yet — the web fills in as people gain Strings on each other.</p>
    {{/if}}

    <div class="mh2-web-panel" data-panel="">
      <p class="mh2-hint">Hover someone to see only their Strings. Click to keep them lit.</p>
    </div>

    {{! One panel per person, shown while they're in focus. }}
    {{#each nodes}}
    <div class="mh2-web-panel" data-panel="{{this.id}}" hidden>
      <h3>{{this.label}}{{#unless this.isActor}} <em>no sheet</em>{{/unless}}</h3>
      {{#if this.conditions}}<p class="mh2-web-conds">{{this.conditions}}</p>{{/if}}

      <h4 class="out">Holds Strings on</h4>
      {{#if this.holds.length}}
      <ul>{{#each this.holds}}<li><span>{{this.name}}</span><b>{{this.count}}</b></li>{{/each}}</ul>
      {{else}}<p class="mh2-empty">No one.</p>{{/if}}

      <h4 class="in">Strings held on them by</h4>
      {{#if this.heldBy.length}}
      <ul>{{#each this.heldBy}}<li><span>{{this.name}}</span><b>{{this.count}}</b></li>{{/each}}</ul>
      {{else}}<p class="mh2-empty">No one.</p>{{/if}}

      {{#if this.isActor}}
      <a class="mh2-btn mh2-btn-text" data-action="openSheet" data-actor-id="{{this.actorId}}"><i class="fa-solid fa-id-card"></i> open sheet</a>
      {{/if}}
    </div>
    {{/each}}

  </aside>
  {{else}}
  <p class="mh2-empty">No one here yet — the web fills in as characters are created and gain Strings.</p>
  {{/if}}

</div>
